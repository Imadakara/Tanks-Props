; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tanks&Props"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

run/main_scene="res://scenes/main_menu/MainMenu.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="forward_plus"

[layer_names]

3d_physics/layer_1="environment"
3d_physics/layer_2="tanks"
3d_physics/layer_3="projectiles"
3d_physics/layer_4="disguise_obstacle"
3d_physics/layer_5="objective_zone"
3d_physics/layer_6="ammo_crates"

